# Priyasa production environment template
# IMPORTANT: This committed file intentionally contains NO production secrets.
# Add the real values in Hostinger Environment Variables / Secrets.

NODE_ENV="production"
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"
SESSION_SECRET="replace-with-32-plus-character-secret"
NEXT_PUBLIC_APP_URL="https://priyasa.com"

# Payments
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Cache / jobs
REDIS_URL=""
CRON_SECRET=""

# Shipping
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
SHIPROCKET_PICKUP_LOCATION="Primary"
SHIPROCKET_PICKUP_PINCODE=""
SHIPROCKET_DEFAULT_EMAIL="orders@priyasa.com"
SHIPROCKET_WEBHOOK_SECRET=""
SHIPPING_PROVIDER="shiprocket"
SHIPPRIME_BASE_URL=""
SHIPPRIME_API_KEY=""

# Email
RESEND_API_KEY=""
EMAIL_FROM="Priyasa <orders@priyasa.com>"

# Priyasa API / OTP / device registration
PRIYASA_API_BASE_URL="https://api.priyasa.com"
PRIYASA_API_TOKEN=""
PRIYASA_WHATSAPP_SEND_PATH=""
OTP_PROVIDER_URL="https://api.priyasa.com"
OTP_PROVIDER_TOKEN=""
PRIYASA_DEVICE_REGISTER_PATH="/api/device/register"

# Firebase / FCM web push
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# Meta / WhatsApp / Ads
META_ACCESS_TOKEN=""
META_WABA_ID=""
META_PHONE_NUMBER_ID=""
META_AD_ACCOUNT_ID=""
